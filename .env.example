# PLACEHOLDER — copy this file to .env and replace all placeholder values.
# Never commit .env to git.
#
# See README.md (Environment Variables) and SPEC.md §7.2 for details.
#
# --- Database (Docker Compose internal hostnames) ---
# MONGO_URI=mongodb://mongodb:27017/LibreChat
# REDIS_URI=redis://redis:6379
#
# --- LLM (Ollama on model server, not in Compose) ---
# OLLAMA_BASE_URL=http://YOUR_SERVER_IP:11434
#
# --- Web search ---
# TAVILY_API_KEY=your_tavily_api_key_here
#
# --- LibreChat security (generate strong random values in production) ---
# JWT_SECRET=replace_with_long_random_string
# JWT_REFRESH_SECRET=replace_with_another_long_random_string
# CREDS_KEY=replace_with_32_character_key
# CREDS_IV=replace_with_16_char_iv
