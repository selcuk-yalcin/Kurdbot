# Copy to .env and fill in real values:
#   cp .env.example .env
# Never commit .env to git.
#
# Generate secrets (examples):
#   openssl rand -hex 32    # JWT_SECRET / JWT_REFRESH_SECRET
#   openssl rand -hex 16    # CREDS_KEY (32 hex chars)
#   openssl rand -hex 8     # CREDS_IV  (16 hex chars)

# --- App ---
# Host port mapped to LibreChat (container always listens on 3080)
LIBRECHAT_PORT=3080
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Allow registration (set to false in production if needed)
ALLOW_REGISTRATION=true

# --- Database (Docker Compose service hostnames) ---
MONGO_URI=mongodb://mongodb:27017/LibreChat
REDIS_URI=redis://redis:6379
USE_REDIS=true

# --- LLM: Ollama on the model server (NOT inside Docker Compose) ---
# Examples:
#   Remote GPU host:  http://203.0.113.10:11434
#   Same machine:     http://host.docker.internal:11434
OLLAMA_BASE_URL=http://YOUR_SERVER_IP:11434

# --- Web search (https://www.tavily.com) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- LibreChat security (REQUIRED — replace before first start) ---
JWT_SECRET=replace_with_long_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_long_random_hex_string
# Exactly 32 characters:
CREDS_KEY=replace_with_32_character_secret_
# Exactly 16 characters:
CREDS_IV=replace_16_chars_

# --- Optional ---
# DEBUG_LOGGING=true
# CONSOLE_JSON=false
